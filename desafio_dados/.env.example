# copie para .env e ajuste; .env nao vai para o git
POSTGRES_USER=desafio
POSTGRES_PASSWORD=desafio
POSTGRES_DB=desafio

MONGO_USER=desafio
MONGO_PASSWORD=desafio

SUPERSET_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# portas expostas no host (mude se ja estiverem em uso)
POSTGRES_HOST_PORT=5432
MONGO_HOST_PORT=27017
SUPERSET_HOST_PORT=8088

# Desafio 2

# LGPD (RF33): segredos de protecao. Gere valores aleatorios, por exemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
LGPD_SALT=troque-por-um-salt-aleatorio
LGPD_CHAVE_PSEUDONIMO=troque-por-uma-chave-aleatoria

# papel somente leitura das camadas de consumo (gold, qualidade, controle), usado pelo Superset
CONSUMO_DB_USER=consumo
CONSUMO_DB_PASSWORD=consumo

# OpenMetadata (perfil governanca): bancos proprios no mesmo PostgreSQL
OM_DB_USER=openmetadata
OM_DB_PASSWORD=openmetadata
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# administrador do OpenMetadata (usado por openmetadata/provisionar.py)
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=admin
# token do ingestion-bot: preenchido por openmetadata/provisionar.py; usado pelo workflow metadados.hwf
OM_BOT_TOKEN=
# chave Fernet do OpenMetadata (cifra os segredos das conexoes). Gere uma antes da primeira subida:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Depois da primeira subida, nao troque: os segredos ja cifrados deixariam de abrir.
OM_FERNET_KEY=

HOP_WEB_HOST_PORT=8081
SPARK_UI_HOST_PORT=8090
OPENMETADATA_HOST_PORT=8585
AIRFLOW_HOST_PORT=8082
MAILPIT_HOST_PORT=8025

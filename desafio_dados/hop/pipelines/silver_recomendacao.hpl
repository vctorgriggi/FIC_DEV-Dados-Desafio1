<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><name>silver_recomendacao</name><name_sync_with_filename>Y</name_sync_with_filename><description>Valida e carrega recomendacoes na Silver</description><extended_description>Usa somente o snapshot fixo ingerido na Bronze e preserva a data de geracao.</extended_description><pipeline_version/><pipeline_type>Normal</pipeline_type><pipeline_status>0</pipeline_status><parameters><parameter><name>EXECUCAO_ID</name><default_value/><description>UUID da execucao Bronze corrente</description></parameter></parameters></info>
  <notepads/><order><hop><from>recomendacoes validas</from><to>normalizar textos</to><enabled>Y</enabled></hop><hop><from>normalizar textos</from><to>gravar silver</to><enabled>Y</enabled></hop></order>
  <transform><name>recomendacoes validas</name><type>TableInput</type><description>Validacao de chaves, pontuacao, posicao e classificacao</description><connection>postgres_desafio</connection><sql>SELECT r.usuario_id::integer AS usuario_id, r.conteudo_id::integer AS conteudo_id, r.pontuacao::numeric(5,2) AS pontuacao, r.posicao::integer AS posicao, lower(unaccent(btrim(r.classificacao))) AS classificacao, r.gerado_em::timestamp AS gerado_em, r._execucao_id, r._origem, r._ingerido_em
FROM bronze.recomendacoes r JOIN silver.usuario u ON u.usuario_id = NULLIF(btrim(r.usuario_id), '')::integer AND u._execucao_id = r._execucao_id JOIN silver.conteudo c ON c.conteudo_id = NULLIF(btrim(r.conteudo_id), '')::integer AND c._execucao_id = r._execucao_id
WHERE r._execucao_id = '${EXECUCAO_ID}' AND btrim(r.usuario_id) ~ '^[0-9]+$' AND btrim(r.conteudo_id) ~ '^[0-9]+$' AND btrim(r.pontuacao) ~ '^[0-9]+(\.[0-9]+)?$' AND r.pontuacao::numeric BETWEEN 0 AND 100 AND btrim(r.posicao) ~ '^[1-9][0-9]*$' AND lower(unaccent(btrim(r.classificacao))) IN ('positivo','estavel','negativo') AND btrim(r.gerado_em) ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}'</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><distribute>Y</distribute><copies>1</copies><GUI><xloc>128</xloc><yloc>96</yloc></GUI><partitioning><method>none</method><schema_name/></partitioning><attributes/></transform>
  <transform><name>normalizar textos</name><type>StringOperations</type><description>Limpeza textual com transformer nativo do Hop</description><fields><field><in_stream_name>classificacao</in_stream_name><out_stream_name>classificacao</out_stream_name><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><right_pad_char/><left_pad_char/><mask/></field></fields><distribute>Y</distribute><copies>1</copies><GUI><xloc>288</xloc><yloc>96</yloc></GUI><partitioning><method>none</method><schema_name/></partitioning><attributes/></transform>
  <transform><name>gravar silver</name><type>TableOutput</type><description>silver.recomendacao</description><connection>postgres_desafio</connection><schema>silver</schema><table>recomendacao</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><fields><field><column_name>usuario_id</column_name><stream_name>usuario_id</stream_name></field><field><column_name>conteudo_id</column_name><stream_name>conteudo_id</stream_name></field><field><column_name>pontuacao</column_name><stream_name>pontuacao</stream_name></field><field><column_name>posicao</column_name><stream_name>posicao</stream_name></field><field><column_name>classificacao</column_name><stream_name>classificacao</stream_name></field><field><column_name>gerado_em</column_name><stream_name>gerado_em</stream_name></field><field><column_name>_execucao_id</column_name><stream_name>_execucao_id</stream_name></field><field><column_name>_origem</column_name><stream_name>_origem</stream_name></field><field><column_name>_ingerido_em</column_name><stream_name>_ingerido_em</stream_name></field></fields><distribute>Y</distribute><copies>1</copies><GUI><xloc>416</xloc><yloc>96</yloc></GUI><partitioning><method>none</method><schema_name/></partitioning><attributes/></transform>
  <transform_error_handling/><attributes/>
</pipeline>



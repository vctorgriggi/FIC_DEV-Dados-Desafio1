<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>silver</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Camada Silver (RF21, RF23, RF30, RF33): valida cada fonte e publica tudo numa transacao</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <parameters><parameter><name>EXECUCAO_ID</name><default_value></default_value><description>UUID da execucao (vazio = gerar um novo)</description></parameter></parameters>
  <actions>
    <action>
      <name>inicio</name>
      <description></description>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>abortar</name>
      <description></description>
      <type>ABORT</type>
      <attributes/>
      <message>[${EXECUCAO_ID}] silver interrompida; a Silver anterior continua publicada</message>
      <always_log_rows>N</always_log_rows>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>336</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>silver_usuario</name>
      <description></description>
      <type>WORKFLOW</type>
      <attributes/>
      <filename>${PROJECT_HOME}/workflows/etapa.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>N</pass_all_parameters><parameter><name>EXECUCAO_ID</name><stream_name/><value>${EXECUCAO_ID}</value></parameter><parameter><name>ETAPA</name><stream_name/><value>silver_usuario</value></parameter><parameter><name>PIPELINE</name><stream_name/><value>silver_usuario.hpl</value></parameter></parameters>
      <parallel>N</parallel>
      <xloc>192</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>silver_conteudo</name>
      <description></description>
      <type>WORKFLOW</type>
      <attributes/>
      <filename>${PROJECT_HOME}/workflows/etapa.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>N</pass_all_parameters><parameter><name>EXECUCAO_ID</name><stream_name/><value>${EXECUCAO_ID}</value></parameter><parameter><name>ETAPA</name><stream_name/><value>silver_conteudo</value></parameter><parameter><name>PIPELINE</name><stream_name/><value>silver_conteudo.hpl</value></parameter></parameters>
      <parallel>N</parallel>
      <xloc>336</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>silver_interacao</name>
      <description></description>
      <type>WORKFLOW</type>
      <attributes/>
      <filename>${PROJECT_HOME}/workflows/etapa.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>N</pass_all_parameters><parameter><name>EXECUCAO_ID</name><stream_name/><value>${EXECUCAO_ID}</value></parameter><parameter><name>ETAPA</name><stream_name/><value>silver_interacao</value></parameter><parameter><name>PIPELINE</name><stream_name/><value>silver_interacao.hpl</value></parameter></parameters>
      <parallel>N</parallel>
      <xloc>480</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>silver_comentario</name>
      <description></description>
      <type>WORKFLOW</type>
      <attributes/>
      <filename>${PROJECT_HOME}/workflows/etapa.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>N</pass_all_parameters><parameter><name>EXECUCAO_ID</name><stream_name/><value>${EXECUCAO_ID}</value></parameter><parameter><name>ETAPA</name><stream_name/><value>silver_comentario</value></parameter><parameter><name>PIPELINE</name><stream_name/><value>silver_comentario.hpl</value></parameter></parameters>
      <parallel>N</parallel>
      <xloc>624</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>silver_recomendacao</name>
      <description></description>
      <type>WORKFLOW</type>
      <attributes/>
      <filename>${PROJECT_HOME}/workflows/etapa.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>N</pass_all_parameters><parameter><name>EXECUCAO_ID</name><stream_name/><value>${EXECUCAO_ID}</value></parameter><parameter><name>ETAPA</name><stream_name/><value>silver_recomendacao</value></parameter><parameter><name>PIPELINE</name><stream_name/><value>silver_recomendacao.hpl</value></parameter></parameters>
      <parallel>N</parallel>
      <xloc>768</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>iniciar publicacao</name>
      <description></description>
      <type>SQL</type>
      <attributes/>
      <sql>SELECT controle.iniciar_etapa('${EXECUCAO_ID}', 'silver_publicacao')</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>Y</sendOneStatement>
      <connection>postgres_desafio</connection>
      <parallel>N</parallel>
      <xloc>912</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>publicar silver</name>
      <description>troca Silver, dados mestres, pseudonimos e quarentena numa unica transacao</description>
      <type>SQL</type>
      <attributes/>
      <sql>SELECT * FROM silver.publicar('${EXECUCAO_ID}')</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>Y</sendOneStatement>
      <connection>postgres_desafio</connection>
      <parallel>N</parallel>
      <xloc>1072</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>concluir publicacao</name>
      <description></description>
      <type>SQL</type>
      <attributes/>
      <sql>SELECT controle.concluir_etapa('${EXECUCAO_ID}', 'silver_publicacao')</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>Y</sendOneStatement>
      <connection>postgres_desafio</connection>
      <parallel>N</parallel>
      <xloc>1232</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>fim</name>
      <description></description>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1392</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>registrar falha na publicacao</name>
      <description></description>
      <type>SQL</type>
      <attributes/>
      <sql>SELECT controle.registrar_falha('${EXECUCAO_ID}', 'silver_publicacao', 'publicacao desfeita; detalhes no log do Hop')</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>Y</sendOneStatement>
      <connection>postgres_desafio</connection>
      <parallel>N</parallel>
      <xloc>1072</xloc>
      <yloc>336</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>silver_usuario</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>silver_conteudo</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>

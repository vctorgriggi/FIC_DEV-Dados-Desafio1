<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>etapa</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Executa um pipeline como etapa registrada em controle.etapa (inicio, contagens, status ou falha)</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <parameters><parameter><name>EXECUCAO_ID</name><default_value></default_value><description>execucao em andamento</description></parameter><parameter><name>ETAPA</name><default_value></default_value><description>nome da etapa em controle.etapa</description></parameter><parameter><name>PIPELINE</name><default_value></default_value><description>arquivo em hop/pipelines/</description></parameter></parameters>
  <actions>
    <action>
      <name>inicio</name>
      <description></description>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>registrar no log</name>
      <description></description>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <loglevel>Basic</loglevel>
      <logmessage>[${EXECUCAO_ID}] etapa ${ETAPA}: inicio (${PIPELINE})</logmessage>
      <logsubject/>
      <parallel>N</parallel>
      <xloc>192</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>iniciar etapa</name>
      <description></description>
      <type>SQL</type>
      <attributes/>
      <sql>SELECT controle.iniciar_etapa('${EXECUCAO_ID}', '${ETAPA}')</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>Y</sendOneStatement>
      <connection>postgres_desafio</connection>
      <parallel>N</parallel>
      <xloc>352</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>executar pipeline</name>
      <description></description>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/pipelines/${PIPELINE}</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>N</pass_all_parameters><parameter><name>EXECUCAO_ID</name><stream_name/><value>${EXECUCAO_ID}</value></parameter></parameters>
      <parallel>N</parallel>
      <xloc>512</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>concluir etapa</name>
      <description>mede lidos, gravados e quarentena; quarentena &gt; 0 = sucesso com ressalvas</description>
      <type>SQL</type>
      <attributes/>
      <sql>SELECT controle.concluir_etapa('${EXECUCAO_ID}', '${ETAPA}')</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>Y</sendOneStatement>
      <connection>postgres_desafio</connection>
      <parallel>N</parallel>
      <xloc>672</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>fim</name>
      <description></description>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>832</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>registrar falha</name>
      <description></description>
      <type>SQL</type>
      <attributes/>
      <sql>SELECT controle.registrar_falha('${EXECUCAO_ID}', '${ETAPA}', 'falha no pipeline ${PIPELINE}; detalhes no log do Hop')</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>Y</sendOneStatement>
      <connection>postgres_desafio</connection>
      <parallel>N</parallel>
      <xloc>592</xloc>
      <yloc>288</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>abortar</name>
      <description></description>
      <type>ABORT</type>
      <attributes/>
      <message>[${EXECUCAO_ID}] etapa ${ETAPA} falhou</message>
      <always_log_rows>N</always_log_rows>
      <parallel>N</parallel>
      <xloc>752</xloc>
      <yloc>288</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>inicio</from>
      <to>registrar no log</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>registrar no log</from>
      <to>iniciar etapa</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>iniciar etapa</from>
      <to>executar pipeline</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>executar pipeline</from>
      <to>concluir etapa</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>concluir etapa</from>
      <to>fim</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>executar pipeline</from>
      <to>registrar falha</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>concluir etapa</from>
      <to>registrar falha</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>registrar falha</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>iniciar etapa</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>

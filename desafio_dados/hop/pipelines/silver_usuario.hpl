<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><name>silver_usuario</name><name_sync_with_filename>Y</name_sync_with_filename><description>Padroniza usuarios e aplica protecao LGPD</description><extended_description>Seleciona a ultima versao por usuario_id e nao publica CPF, telefone ou data de nascimento na Silver.</extended_description><pipeline_version/><pipeline_type>Normal</pipeline_type><pipeline_status>0</pipeline_status><parameters><parameter><name>EXECUCAO_ID</name><default_value/><description>UUID da execucao Bronze corrente</description></parameter></parameters><capture_transform_performance>N</capture_transform_performance><transform_performance_capturing_delay>1000</transform_performance_capturing_delay><transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit><created_user>-</created_user><modified_user>-</modified_user></info>
  <notepads/><order><hop><from>usuarios validos</from><to>normalizar textos</to><enabled>Y</enabled></hop><hop><from>normalizar textos</from><to>gravar silver</to><enabled>Y</enabled></hop></order>
  <transform><name>usuarios validos</name><type>TableInput</type><description>Validacao, sobrevivencia e protecao LGPD</description><connection>postgres_desafio</connection><sql>WITH candidatos AS (
 SELECT u.*, row_number() OVER (PARTITION BY NULLIF(btrim(u.usuario_id), '')::integer ORDER BY CASE WHEN u._origem LIKE '%/lote_2/%' THEN 1 ELSE 0 END DESC, NULLIF(btrim(u.atualizado_em), '')::timestamp DESC NULLS LAST, u._linha DESC) AS rn
 FROM bronze.usuarios u
 WHERE u._execucao_id = '${EXECUCAO_ID}' AND btrim(u.usuario_id) ~ '^[0-9]+$' AND btrim(u.usuario_id)::integer &gt; 0 AND NULLIF(btrim(u.nome), '') IS NOT NULL AND btrim(u.email) ~* '^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$' AND (u.cpf IS NULL OR btrim(u.cpf) ~ '^[0-9]{11}$|^[0-9]{3}\.[0-9]{3}\.[0-9]{3}-[0-9]{2}$') AND (u.data_cadastro IS NULL OR btrim(u.data_cadastro) ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
), normalizados AS (
 SELECT usuario_id::integer AS usuario_id, lgpd.pseudonimizar(usuario_id, '${LGPD_CHAVE_PSEUDONIMO}') AS usuario_pseudo, lgpd.mascarar_nome(btrim(nome)) AS nome_mascarado, lgpd.mascarar_email(lower(btrim(email))) AS email_mascarado, CASE WHEN NULLIF(btrim(email), '') IS NULL THEN NULL ELSE lgpd.hash_salt(lower(btrim(email)), '${LGPD_SALT}') END AS email_hash, CASE WHEN NULLIF(regexp_replace(cpf, '[^0-9]', '', 'g'), '') IS NULL THEN NULL ELSE lgpd.hash_salt(regexp_replace(cpf, '[^0-9]', '', 'g'), '${LGPD_SALT}') END AS cpf_hash, CASE WHEN data_nascimento ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' THEN CASE WHEN age(CURRENT_DATE, data_nascimento::date) &lt; interval '18 years' THEN '0-17' WHEN age(CURRENT_DATE, data_nascimento::date) &lt; interval '30 years' THEN '18-29' WHEN age(CURRENT_DATE, data_nascimento::date) &lt; interval '45 years' THEN '30-44' ELSE '45+' END END AS faixa_etaria, NULLIF(btrim(cidade), '') AS cidade, upper(NULLIF(btrim(uf), '')) AS uf, CASE WHEN data_cadastro ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' THEN data_cadastro::date END AS data_cadastro, CASE WHEN atualizado_em ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}' THEN atualizado_em::timestamp END AS atualizado_em, _execucao_id, _origem, _ingerido_em
 FROM candidatos WHERE rn = 1
)
SELECT usuario_id, usuario_pseudo, nome_mascarado, email_mascarado, email_hash, cpf_hash, faixa_etaria, cidade, uf, data_cadastro, atualizado_em, _execucao_id, _origem, _ingerido_em FROM normalizados</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><distribute>Y</distribute><copies>1</copies><GUI><xloc>128</xloc><yloc>96</yloc></GUI><partitioning><method>none</method><schema_name/></partitioning><attributes/></transform>
  <transform><name>normalizar textos</name><type>StringOperations</type><description>Limpeza textual com transformer nativo do Hop</description><fields><field><in_stream_name>nome_mascarado</in_stream_name><out_stream_name>nome_mascarado</out_stream_name><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><right_pad_char/><left_pad_char/><mask/></field><field><in_stream_name>email_mascarado</in_stream_name><out_stream_name>email_mascarado</out_stream_name><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><right_pad_char/><left_pad_char/><mask/></field><field><in_stream_name>cidade</in_stream_name><out_stream_name>cidade</out_stream_name><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><right_pad_char/><left_pad_char/><mask/></field><field><in_stream_name>uf</in_stream_name><out_stream_name>uf</out_stream_name><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><right_pad_char/><left_pad_char/><mask/></field><field><in_stream_name>faixa_etaria</in_stream_name><out_stream_name>faixa_etaria</out_stream_name><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><right_pad_char/><left_pad_char/><mask/></field></fields><distribute>Y</distribute><copies>1</copies><GUI><xloc>288</xloc><yloc>96</yloc></GUI><partitioning><method>none</method><schema_name/></partitioning><attributes/></transform>
  <transform><name>gravar silver</name><type>TableOutput</type><description>silver.usuario</description><connection>postgres_desafio</connection><schema>silver</schema><table>usuario</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><fields><field><column_name>usuario_id</column_name><stream_name>usuario_id</stream_name></field><field><column_name>usuario_pseudo</column_name><stream_name>usuario_pseudo</stream_name></field><field><column_name>nome_mascarado</column_name><stream_name>nome_mascarado</stream_name></field><field><column_name>email_mascarado</column_name><stream_name>email_mascarado</stream_name></field><field><column_name>email_hash</column_name><stream_name>email_hash</stream_name></field><field><column_name>cpf_hash</column_name><stream_name>cpf_hash</stream_name></field><field><column_name>faixa_etaria</column_name><stream_name>faixa_etaria</stream_name></field><field><column_name>cidade</column_name><stream_name>cidade</stream_name></field><field><column_name>uf</column_name><stream_name>uf</stream_name></field><field><column_name>data_cadastro</column_name><stream_name>data_cadastro</stream_name></field><field><column_name>atualizado_em</column_name><stream_name>atualizado_em</stream_name></field><field><column_name>_execucao_id</column_name><stream_name>_execucao_id</stream_name></field><field><column_name>_origem</column_name><stream_name>_origem</stream_name></field><field><column_name>_ingerido_em</column_name><stream_name>_ingerido_em</stream_name></field></fields><distribute>Y</distribute><copies>1</copies><GUI><xloc>416</xloc><yloc>96</yloc></GUI><partitioning><method>none</method><schema_name/></partitioning><attributes/></transform>
  <transform_error_handling/><attributes/>
</pipeline>


<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>exportar_json</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/28 19:00:00.000</created_date>
    <modified_date>2026/09/28 19:00:00.000</modified_date>
  </info>

  <transform>
    <type>TableInput</type>
    <name>Ler Silver Interacao</name>
    <sql>SELECT * FROM silver.interacao;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>postgres_desafio</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>160</xloc>
      <yloc>128</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>JsonOutput</type>
    <name>Escrever JSON Interacao</name>

    <operation_type>writetofile</operation_type>
    <encoding>UTF-8</encoding>

    <outputValue>outputValue</outputValue>
    <jsonBloc>data</jsonBloc>
    <nrRowsInBloc>0</nrRowsInBloc>

    <compatibility_mode>N</compatibility_mode>

    <fileName>${DIR_SILVER}/interacoes</fileName>
    <fileAppended>N</fileAppended>
    <createParentFolder>Y</createParentFolder>
    <doNotOpenNewFileInit>N</doNotOpenNewFileInit>
    <transformNrInFilename>N</transformNrInFilename>
    <partNrInFilename>N</partNrInFilename>
    <dateInFilename>N</dateInFilename>
    <timeInFilename>N</timeInFilename>
    <extension>json</extension>

    <fields/>

    <distribute>Y</distribute>
    <copies>1</copies>

    <GUI>
      <xloc>400</xloc>
      <yloc>128</yloc>
      <draw>Y</draw>
    </GUI>

    <description/>

    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>

    <attributes/>
  </transform>

  <order>
    <hop>
      <from>Ler Silver Interacao</from>
      <to>Escrever JSON Interacao</to>
      <enabled>Y</enabled>
    </hop>
  </order>

  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
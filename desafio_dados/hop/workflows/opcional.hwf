<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>opcional</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Executa workflows/&lt;ETAPA&gt;.hwf se existir; senao registra a etapa como ignorada</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <parameters><parameter><name>EXECUCAO_ID</name><default_value></default_value><description>execucao em andamento</description></parameter><parameter><name>ETAPA</name><default_value></default_value><description>qualidade, gold ou metadados</description></parameter></parameters>
  <actions>
    <action>
      <name>inicio</name>
      <description></description>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>workflow existe?</name>
      <description></description>
      <type>FILE_EXISTS</type>
      <attributes/>
      <filename>${PROJECT_HOME}/workflows/${ETAPA}.hwf</filename>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>executar etapa</name>
      <description></description>
      <type>WORKFLOW</type>
      <attributes/>
      <filename>${PROJECT_HOME}/workflows/${ETAPA}.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>N</pass_all_parameters><parameter><name>EXECUCAO_ID</name><stream_name/><value>${EXECUCAO_ID}</value></parameter></parameters>
      <parallel>N</parallel>
      <xloc>400</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>registrar ignorada</name>
      <description></description>
      <type>SQL</type>
      <attributes/>
      <sql>SELECT controle.registrar_ignorada('${EXECUCAO_ID}', '${ETAPA}', 'workflows/${ETAPA}.hwf ainda nao existe no projeto')</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>Y</sendOneStatement>
      <connection>postgres_desafio</connection>
      <parallel>N</parallel>
      <xloc>400</xloc>
      <yloc>240</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>fim</name>
      <description></description>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>576</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>abortar</name>
      <description></description>
      <type>ABORT</type>
      <attributes/>
      <message>[${EXECUCAO_ID}] etapa ${ETAPA} falhou</message>
      <always_log_rows>N</always_log_rows>
      <parallel>N</parallel>
      <xloc>576</xloc>
      <yloc>32</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>inicio</from>
      <to>workflow existe?</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>workflow existe?</from>
      <to>executar etapa</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>workflow existe?</from>
      <to>registrar ignorada</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>executar etapa</from>
      <to>fim</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>registrar ignorada</from>
      <to>fim</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>executar etapa</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>registrar ignorada</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>

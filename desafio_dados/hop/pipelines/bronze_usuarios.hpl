<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><name>bronze_usuarios</name><name_sync_with_filename>Y</name_sync_with_filename><description>Ingere usuarios sem transformacao</description><extended_description>Fonte com dados pessoais, restrita ao banco dono.</extended_description><pipeline_version/><pipeline_type>Normal</pipeline_type><pipeline_status>0</pipeline_status><parameters><parameter><name>EXECUCAO_ID</name><default_value/><description>UUID da execucao</description></parameter></parameters><capture_transform_performance>N</capture_transform_performance><transform_performance_capturing_delay>1000</transform_performance_capturing_delay><transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit><created_user>-</created_user><modified_user>-</modified_user><key_for_session_key/><is_key_private>N</is_key_private></info>
  <notepads/>
  <order><hop><from>usuarios Desafio 1</from><to>auditoria Desafio 1</to><enabled>Y</enabled></hop><hop><from>usuarios lote 2</from><to>auditoria lote 2</to><enabled>Y</enabled></hop><hop><from>auditoria Desafio 1</from><to>execucao Desafio 1</to><enabled>Y</enabled></hop><hop><from>auditoria lote 2</from><to>execucao lote 2</to><enabled>Y</enabled></hop><hop><from>execucao Desafio 1</from><to>gravar bronze</to><enabled>Y</enabled></hop><hop><from>execucao lote 2</from><to>gravar bronze</to><enabled>Y</enabled></hop></order>
  <transform>
    <name>usuarios Desafio 1</name><type>CsvInput</type><description>Cadastro original</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <filename>${DIR_BRUTOS}/usuarios.csv</filename><filename_field/><rownum_field>_linha</rownum_field><include_filename>N</include_filename><include_rownum>Y</include_rownum><separator>,</separator><enclosure>&quot;</enclosure><escape_character>\\</escape_character><header>Y</header><buffer_size>50000</buffer_size><lazy_conversion_active>N</lazy_conversion_active><add_filename_result>N</add_filename_result><parallel> N </parallel><encoding>UTF-8</encoding>
    <fields>
      <field><name>usuario_id</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>nome</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>email</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>cpf</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>data_nascimento</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>telefone</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>cidade</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>uf</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>data_cadastro</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>atualizado_em</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field>
    </fields><attributes/><GUI><xloc>64</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <name>usuarios lote 2</name><type>CsvInput</type><description>Cadastro incremental</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <filename>${DIR_BRUTOS}/lote_2/usuarios.csv</filename><filename_field/><rownum_field>_linha</rownum_field><include_filename>N</include_filename><include_rownum>Y</include_rownum><separator>,</separator><enclosure>&quot;</enclosure><escape_character>\\</escape_character><header>Y</header><buffer_size>50000</buffer_size><lazy_conversion_active>N</lazy_conversion_active><add_filename_result>N</add_filename_result><parallel> N </parallel><encoding>UTF-8</encoding>
    <fields>
      <field><name>usuario_id</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>nome</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>email</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>cpf</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>data_nascimento</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>telefone</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>cidade</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>uf</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>data_cadastro</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>atualizado_em</name><type>String</type><format/><currency/><decimal/><group/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field>
    </fields><attributes/><GUI><xloc>64</xloc><yloc>288</yloc></GUI>
  </transform>
  <transform>
    <name>auditoria Desafio 1</name><type>Constant</type><description>Auditoria da fonte original</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>_origem</name><type>String</type><format/><nullif>dados/brutos/usuarios.csv</nullif><set_empty_string>N</set_empty_string></field></fields><attributes/><GUI><xloc>288</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <name>auditoria lote 2</name><type>Constant</type><description>Auditoria da fonte incremental</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>_origem</name><type>String</type><format/><nullif>dados/brutos/lote_2/usuarios.csv</nullif><set_empty_string>N</set_empty_string></field></fields><attributes/><GUI><xloc>288</xloc><yloc>288</yloc></GUI>
  </transform>
  <transform>
    <name>execucao Desafio 1</name><type>GetVariable</type><description>Materializa o identificador da execucao</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>_execucao_id</name><variable>${EXECUCAO_ID}</variable><type>String</type></field></fields><attributes/><GUI><xloc>416</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <name>execucao lote 2</name><type>GetVariable</type><description>Materializa o identificador da execucao</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>_execucao_id</name><variable>${EXECUCAO_ID}</variable><type>String</type></field></fields><attributes/><GUI><xloc>416</xloc><yloc>288</yloc></GUI>
  </transform>
  <transform>
    <name>gravar bronze</name><type>TableOutput</type><description>Bronze append-only</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>postgres_desafio</connection><schema>bronze</schema><table>usuarios</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields>
    <fields><field><column_name>usuario_id</column_name><stream_name>usuario_id</stream_name></field><field><column_name>nome</column_name><stream_name>nome</stream_name></field><field><column_name>email</column_name><stream_name>email</stream_name></field><field><column_name>cpf</column_name><stream_name>cpf</stream_name></field><field><column_name>data_nascimento</column_name><stream_name>data_nascimento</stream_name></field><field><column_name>telefone</column_name><stream_name>telefone</stream_name></field><field><column_name>cidade</column_name><stream_name>cidade</stream_name></field><field><column_name>uf</column_name><stream_name>uf</stream_name></field><field><column_name>data_cadastro</column_name><stream_name>data_cadastro</stream_name></field><field><column_name>atualizado_em</column_name><stream_name>atualizado_em</stream_name></field><field><column_name>_execucao_id</column_name><stream_name>_execucao_id</stream_name></field><field><column_name>_origem</column_name><stream_name>_origem</stream_name></field><field><column_name>_linha</column_name><stream_name>_linha</stream_name></field></fields><attributes/><GUI><xloc>544</xloc><yloc>192</yloc></GUI>
  </transform>
  <transform_error_handling/><attributes/>
</pipeline>

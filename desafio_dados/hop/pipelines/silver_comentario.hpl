<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>silver_comentario</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Valida comentarios da bronze e separa aprovados e rejeitados</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>EXECUCAO_ID</name>
        <default_value/>
        <description>execucao cuja bronze sera validada</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>Silver - comentario (RF21, RF23)
1. classificar: validacao.classificar_comentarios aplica as regras (sql/silver.sql) sobre a bronze da execucao,
   ja com as correcoes da quarentena; regra vazia = aprovado.
2. aprovado?: separa aprovados e rejeitados.
3. grava na area de preparo; silver.publicar() troca a Silver numa transacao unica.</note>
      <xloc>64</xloc>
      <yloc>32</yloc>
      <width>560</width>
      <heigth>96</heigth>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop><from>classificar</from><to>aprovado?</to><enabled>Y</enabled></hop>
    <hop><from>aprovado?</from><to>gravar aprovados</to><enabled>Y</enabled></hop>
    <hop><from>aprovado?</from><to>gravar rejeitados</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>classificar</name>
    <type>TableInput</type>
    <description>regras em sql/silver.sql</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_desafio</connection>
    <sql>SELECT * FROM validacao.classificar_comentarios('${EXECUCAO_ID}')</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI><xloc>96</xloc><yloc>192</yloc></GUI>
  </transform>
  <transform>
    <name>aprovado?</name>
    <type>FilterRows</type>
    <description>regra vazia = aprovado</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>gravar aprovados</send_true_to>
    <send_false_to>gravar rejeitados</send_false_to>
    <compare>
      <condition>
        <conditions/>
        <function>IS NULL</function>
        <leftvalue>regra</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>288</xloc><yloc>192</yloc></GUI>
  </transform>
  <transform>
    <name>gravar aprovados</name>
    <type>TableOutput</type>
    <description>validacao.comentario: esvaziada no inicio do pipeline</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_desafio</connection>
    <schema>validacao</schema>
    <table>comentario</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields><field><column_name>usuario_id</column_name><stream_name>usuario_id</stream_name></field><field><column_name>conteudo_id</column_name><stream_name>conteudo_id</stream_name></field><field><column_name>avaliacao</column_name><stream_name>avaliacao</stream_name></field><field><column_name>comentario</column_name><stream_name>comentario</stream_name></field><field><column_name>tags</column_name><stream_name>tags</stream_name></field><field><column_name>data</column_name><stream_name>data</stream_name></field><field><column_name>_execucao_id</column_name><stream_name>_execucao_id</stream_name></field><field><column_name>_origem</column_name><stream_name>_origem</stream_name></field><field><column_name>_linha</column_name><stream_name>_linha</stream_name></field><field><column_name>_ingerido_em</column_name><stream_name>_ingerido_em</stream_name></field><field><column_name>_hash_origem</column_name><stream_name>_hash_origem</stream_name></field></fields>
    <attributes/>
    <GUI><xloc>480</xloc><yloc>128</yloc></GUI>
  </transform>
  <transform>
    <name>gravar rejeitados</name>
    <type>TableOutput</type>
    <description>validacao.comentario_rejeitado: esvaziada no inicio do pipeline</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_desafio</connection>
    <schema>validacao</schema>
    <table>comentario_rejeitado</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields><field><column_name>execucao_id</column_name><stream_name>_execucao_id</stream_name></field><field><column_name>fonte</column_name><stream_name>fonte</stream_name></field><field><column_name>origem</column_name><stream_name>_origem</stream_name></field><field><column_name>linha</column_name><stream_name>_linha</stream_name></field><field><column_name>hash_origem</column_name><stream_name>_hash_origem</stream_name></field><field><column_name>chave_registro</column_name><stream_name>chave_registro</stream_name></field><field><column_name>regra</column_name><stream_name>regra</stream_name></field><field><column_name>severidade</column_name><stream_name>severidade</stream_name></field><field><column_name>mensagem</column_name><stream_name>mensagem</stream_name></field><field><column_name>registro</column_name><stream_name>registro</stream_name></field><field><column_name>registro_original</column_name><stream_name>registro_original</stream_name></field></fields>
    <attributes/>
    <GUI><xloc>480</xloc><yloc>256</yloc></GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

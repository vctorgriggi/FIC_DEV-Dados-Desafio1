<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><name>silver_conteudo</name><name_sync_with_filename>Y</name_sync_with_filename><description>Padroniza e carrega conteudos na Silver</description><extended_description>Seleciona a ultima versao valida por conteudo_id, priorizando lote 2. A leitura e a carga sao transformacoes nativas do Hop; a consulta concentra validacao tipada e deduplicacao por janela.</extended_description><pipeline_version/><pipeline_type>Normal</pipeline_type><pipeline_status>0</pipeline_status><parameters><parameter><name>EXECUCAO_ID</name><default_value/><description>UUID da execucao Bronze corrente</description></parameter></parameters><capture_transform_performance>N</capture_transform_performance><transform_performance_capturing_delay>1000</transform_performance_capturing_delay><transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit><created_user>-</created_user><modified_user>-</modified_user><key_for_session_key/><is_key_private>N</is_key_private></info>
  <notepads/>
  <order><hop><from>conteudos validos</from><to>gravar silver</to><enabled>Y</enabled></hop></order>
  <transform><name>conteudos validos</name><type>TableInput</type><description>Normalizacao, validacao e sobrevivencia de conteudo</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>postgres_desafio</connection><sql>WITH candidatos AS (
    SELECT c.*,
           CASE WHEN c._origem LIKE '%/lote_2/%' THEN 1 ELSE 0 END AS prioridade_fonte,
           row_number() OVER (
               PARTITION BY NULLIF(btrim(c.conteudo_id), '')::integer
               ORDER BY CASE WHEN c._origem LIKE '%/lote_2/%' THEN 1 ELSE 0 END DESC,
                        c._linha DESC
           ) AS sobrevivencia
      FROM bronze.catalogo c
     WHERE c._execucao_id = '${EXECUCAO_ID}'
       AND btrim(c.conteudo_id) ~ '^[0-9]+$'
       AND btrim(c.conteudo_id)::integer &gt; 0
       AND NULLIF(btrim(c.titulo), '') IS NOT NULL
       AND lower(unaccent(btrim(c.tipo))) IN ('curso', 'video', 'artigo', 'podcast')
       AND lower(unaccent(btrim(c.nivel))) IN ('basico', 'intermediario', 'avancado')
       AND btrim(c.carga_horaria_min) ~ '^[0-9]+$'
       AND btrim(c.carga_horaria_min)::integer &gt;= 0
       AND (
           btrim(c.data_publicacao) ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
           OR btrim(c.data_publicacao) ~ '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'
           OR btrim(c.data_publicacao) ~ '^[0-9]{4}/[0-9]{2}/[0-9]{2}$'
       )
), padronizados AS (
    SELECT conteudo_id,
           regexp_replace(btrim(titulo), '\\s+', ' ', 'g') AS titulo,
           CASE lower(unaccent(btrim(tipo))) WHEN 'video' THEN 'Vídeo' ELSE initcap(lower(unaccent(btrim(tipo)))) END AS tipo,
           regexp_replace(btrim(categoria), '\\s+', ' ', 'g') AS categoria,
           CASE lower(unaccent(btrim(nivel))) WHEN 'basico' THEN 'Básico' WHEN 'intermediario' THEN 'Intermediário' ELSE 'Avançado' END AS nivel,
           carga_horaria_min::integer,
           CASE WHEN data_publicacao LIKE '____-__-__' THEN data_publicacao::date WHEN data_publicacao LIKE '__/__/____' THEN to_date(data_publicacao, 'DD/MM/YYYY') ELSE to_date(data_publicacao, 'YYYY/MM/DD') END AS data_publicacao,
           NULLIF(regexp_replace(btrim(descricao), '\\s+', ' ', 'g'), '') AS descricao,
           NULLIF(regexp_replace(btrim(autor), '\\s+', ' ', 'g'), '') AS autor,
           _execucao_id, _origem, _ingerido_em, sobrevivencia
      FROM candidatos
)
SELECT conteudo_id, titulo, tipo, categoria, nivel, carga_horaria_min,
       data_publicacao, descricao, autor, _execucao_id, _origem, _ingerido_em
  FROM padronizados
 WHERE sobrevivencia = 1</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><attributes/><GUI><xloc>128</xloc><yloc>96</yloc></GUI></transform>
  <transform><name>gravar silver</name><type>TableOutput</type><description>silver.conteudo</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>postgres_desafio</connection><schema>silver</schema><table>conteudo</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><fields><field><column_name>conteudo_id</column_name><stream_name>conteudo_id</stream_name></field><field><column_name>titulo</column_name><stream_name>titulo</stream_name></field><field><column_name>tipo</column_name><stream_name>tipo</stream_name></field><field><column_name>categoria</column_name><stream_name>categoria</stream_name></field><field><column_name>nivel</column_name><stream_name>nivel</stream_name></field><field><column_name>carga_horaria_min</column_name><stream_name>carga_horaria_min</stream_name></field><field><column_name>data_publicacao</column_name><stream_name>data_publicacao</stream_name></field><field><column_name>descricao</column_name><stream_name>descricao</stream_name></field><field><column_name>autor</column_name><stream_name>autor</stream_name></field><field><column_name>_execucao_id</column_name><stream_name>_execucao_id</stream_name></field><field><column_name>_origem</column_name><stream_name>_origem</stream_name></field><field><column_name>_ingerido_em</column_name><stream_name>_ingerido_em</stream_name></field></fields><attributes/><GUI><xloc>416</xloc><yloc>96</yloc></GUI></transform>
  <transform_error_handling/><attributes/>
</pipeline>

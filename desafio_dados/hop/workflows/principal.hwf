<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <info>
    <name>principal</name>
    <description>Orquestra o fluxo do Desafio 2 e deixa a publicacao de metadados preparada</description>
    <extended_description>O agendamento e externo. EXECUCAO_ID e MODO entram como parametros do workflow.</extended_description>
    <workflow_version/>
    <workflow_status>0</workflow_status>
    <parameters>
      <parameter><name>EXECUCAO_ID</name><default_value/><description>UUID da execucao</description></parameter>
      <parameter><name>MODO</name><default_value>manual</default_value><description>manual ou agendado</description></parameter>
    </parameters>
    <created_user>-</created_user><created_date>2026/09/27 00:00:00.000</created_date><modified_user>-</modified_user><modified_date>2026/09/27 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <actions>
  <action><name>inicio</name><type>SPECIAL</type><description>Inicio do fluxo</description><start>Y</start><dummy>N</dummy><repeat>N</repeat><success_condition>success</success_condition><attributes/><GUI><xloc>64</xloc><yloc>192</yloc></GUI></action>
  <action><name>abrir execucao</name><type>PIPELINE</type><description>Abre controle.execucao</description><filename>${PROJECT_HOME}/pipelines/controle_execucao.hpl</filename><run_configuration>local</run_configuration><work_directory/><exec_per_row>N</exec_per_row><params><pass_all_parameters>Y</pass_all_parameters></params><parallel>N</parallel><wait_until_finished>Y</wait_until_finished><logging_remote_work>N</logging_remote_work><set_logfile>N</set_logfile><logfile/><logext>log</logext><add_date>N</add_date><add_time>N</add_time><create_parent_folder>N</create_parent_folder><remote_filename/><attributes/><GUI><xloc>256</xloc><yloc>192</yloc></GUI></action>

<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><name>controle_execucao</name><name_sync_with_filename>Y</name_sync_with_filename><description>Abre uma execucao no controle operacional</description><extended_description>Usado pelo workflow principal e por execucoes isoladas.</extended_description><pipeline_version/><pipeline_type>Normal</pipeline_type><pipeline_status>0</pipeline_status><parameters><parameter><name>EXECUCAO_ID</name><default_value/><description>UUID da execucao</description></parameter><parameter><name>FLUXO</name><default_value>completo</default_value><description>Nome do fluxo</description></parameter><parameter><name>MODO</name><default_value>manual</default_value><description>manual ou agendado</description></parameter></parameters><capture_transform_performance>N</capture_transform_performance><transform_performance_capturing_delay>1000</transform_performance_capturing_delay><transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit><created_user>-</created_user><modified_user>-</modified_user><key_for_session_key/><is_key_private>N</is_key_private></info>
  <notepads/>
  <order><hop><from>parametros da execucao</from><to>gravar execucao</to><enabled>Y</enabled></hop></order>
  <transform><name>parametros da execucao</name><type>TableInput</type><description>Materializa os parametros para a carga de controle</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>postgres_desafio</connection><sql>SELECT '${EXECUCAO_ID}'::text AS execucao_id,
       '${FLUXO}'::text AS fluxo,
       '${MODO}'::text AS modo,
       'em_andamento'::text AS status,
       NULL::text AS mensagem</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><attributes/><GUI><xloc>128</xloc><yloc>96</yloc></GUI></transform>
  <transform><name>gravar execucao</name><type>TableOutput</type><description>controle.execucao</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>postgres_desafio</connection><schema>controle</schema><table>execucao</table><commit>1</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>N</use_batch><specify_fields>Y</specify_fields><fields><field><column_name>execucao_id</column_name><stream_name>execucao_id</stream_name></field><field><column_name>fluxo</column_name><stream_name>fluxo</stream_name></field><field><column_name>modo</column_name><stream_name>modo</stream_name></field><field><column_name>status</column_name><stream_name>status</stream_name></field><field><column_name>mensagem</column_name><stream_name>mensagem</stream_name></field></fields><attributes/><GUI><xloc>384</xloc><yloc>96</yloc></GUI></transform>
  <transform_error_handling/><attributes/>
</pipeline>

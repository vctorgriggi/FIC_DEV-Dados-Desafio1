<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>EXECUCAO_ID</name>
        <description>UUID da execucao Bronze corrente</description>
        <default_value/>
      </parameter>
    </parameters>
    <name>silver_conteudo</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Padroniza e carrega conteudos na Silver</description>
    <extended_description>Usa transformers nativos para limpeza textual e selecao do fluxo. A consulta fica restrita a leitura da Bronze e regras relacionais que dependem do banco.</extended_description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/28 01:51:17.675</created_date>
    <modified_date>2026/09/28 01:51:17.675</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>conteudos validos</name>
    <sql>WITH candidatos AS (
    SELECT c.*,
           CASE WHEN c._origem LIKE '%/lote_2/%' THEN 1 ELSE 0 END AS prioridade_fonte,
           row_number() OVER (
               PARTITION BY NULLIF(btrim(c.conteudo_id), '')::integer
               ORDER BY CASE WHEN c._origem LIKE '%/lote_2/%' THEN 1 ELSE 0 END DESC,
                        c._linha DESC
           ) AS sobrevivencia
      FROM bronze.catalogo c
     WHERE c._execucao_id = '${EXECUCAO_ID}'
       AND btrim(c.conteudo_id) ~ '^[0-9]+$'
       AND btrim(c.conteudo_id)::integer > 0
       AND NULLIF(btrim(c.titulo), '') IS NOT NULL
       AND lower(unaccent(btrim(c.tipo))) IN ('curso', 'video', 'artigo', 'podcast')
       AND lower(unaccent(btrim(c.nivel))) IN ('basico', 'intermediario', 'avancado')
       AND btrim(c.carga_horaria_min) ~ '^[0-9]+$'
       AND btrim(c.carga_horaria_min)::integer >= 0
       AND (
           btrim(c.data_publicacao) ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
           OR btrim(c.data_publicacao) ~ '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'
           OR btrim(c.data_publicacao) ~ '^[0-9]{4}/[0-9]{2}/[0-9]{2}$'
       )
), padronizados AS (
    SELECT conteudo_id,
           regexp_replace(btrim(titulo), '\\s+', ' ', 'g') AS titulo,
           CASE lower(unaccent(btrim(tipo))) WHEN 'video' THEN 'VÃ­deo' ELSE initcap(lower(unaccent(btrim(tipo)))) END AS tipo,
           regexp_replace(btrim(categoria), '\\s+', ' ', 'g') AS categoria,
           CASE lower(unaccent(btrim(nivel))) WHEN 'basico' THEN 'BÃ¡sico' WHEN 'intermediario' THEN 'IntermediÃ¡rio' ELSE 'AvanÃ§ado' END AS nivel,
           carga_horaria_min::integer,
           CASE WHEN data_publicacao LIKE '____-__-__' THEN data_publicacao::date WHEN data_publicacao LIKE '__/__/____' THEN to_date(data_publicacao, 'DD/MM/YYYY') ELSE to_date(data_publicacao, 'YYYY/MM/DD') END AS data_publicacao,
           NULLIF(regexp_replace(btrim(descricao), '\\s+', ' ', 'g'), '') AS descricao,
           NULLIF(regexp_replace(btrim(autor), '\\s+', ' ', 'g'), '') AS autor,
           _execucao_id, _origem, _ingerido_em, sobrevivencia
      FROM candidatos
)
SELECT conteudo_id, titulo, tipo, categoria, nivel, carga_horaria_min,
       data_publicacao, descricao, autor, _execucao_id, _origem, _ingerido_em
  FROM padronizados
 WHERE sobrevivencia = 1</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>postgres_desafio</connection>
    <lookup/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>112</xloc>
      <yloc>96</yloc>
    </GUI>
    <description>Normalizacao, validacao e sobrevivencia de conteudo</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>StringOperations</type>
    <name>normalizar textos</name>
    <fields>
      <field>
        <in_stream_name>titulo</in_stream_name>
        <out_stream_name>titulo</out_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
      </field>
      <field>
        <in_stream_name>tipo</in_stream_name>
        <out_stream_name>tipo</out_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
      </field>
      <field>
        <in_stream_name>categoria</in_stream_name>
        <out_stream_name>categoria</out_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
      </field>
      <field>
        <in_stream_name>nivel</in_stream_name>
        <out_stream_name>nivel</out_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
      </field>
      <field>
        <in_stream_name>descricao</in_stream_name>
        <out_stream_name>descricao</out_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
      </field>
      <field>
        <in_stream_name>autor</in_stream_name>
        <out_stream_name>autor</out_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>96</yloc>
    </GUI>
    <description>Limpeza textual com transformer nativo do Hop</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>gravar silver</name>
    <connection>postgres_desafio</connection>
    <schema>silver</schema>
    <table>conteudo</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>N</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field>
        <stream_name>conteudo_id</stream_name>
        <column_name>conteudo_id</column_name>
      </field>
      <field>
        <stream_name>titulo</stream_name>
        <column_name>titulo</column_name>
      </field>
      <field>
        <stream_name>tipo</stream_name>
        <column_name>tipo</column_name>
      </field>
      <field>
        <stream_name>categoria</stream_name>
        <column_name>categoria</column_name>
      </field>
      <field>
        <stream_name>nivel</stream_name>
        <column_name>nivel</column_name>
      </field>
      <field>
        <stream_name>carga_horaria_min</stream_name>
        <column_name>carga_horaria_min</column_name>
      </field>
      <field>
        <stream_name>data_publicacao</stream_name>
        <column_name>data_publicacao</column_name>
      </field>
      <field>
        <stream_name>descricao</stream_name>
        <column_name>descricao</column_name>
      </field>
      <field>
        <stream_name>autor</stream_name>
        <column_name>autor</column_name>
      </field>
      <field>
        <stream_name>_execucao_id</stream_name>
        <column_name>_execucao_id</column_name>
      </field>
      <field>
        <stream_name>_origem</stream_name>
        <column_name>_origem</column_name>
      </field>
      <field>
        <stream_name>_ingerido_em</stream_name>
        <column_name>_ingerido_em</column_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>416</xloc>
      <yloc>96</yloc>
    </GUI>
    <description>silver.conteudo</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>conteudos validos</from>
      <to>normalizar textos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>normalizar textos</from>
      <to>gravar silver</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>

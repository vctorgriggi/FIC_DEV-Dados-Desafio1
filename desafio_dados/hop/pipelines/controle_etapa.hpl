<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>controle_etapa</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Inicia ou finaliza uma etapa do controle operacional</description>
    <extended_description>Usado pelo workflow para registrar o estado de cada etapa.</extended_description>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter><name>EXECUCAO_ID</name><default_value/><description>UUID da execucao</description></parameter>
      <parameter><name>ETAPA</name><default_value/><description>Nome da etapa</description></parameter>
      <parameter><name>OPERACAO</name><default_value>INICIO</default_value><description>INICIO ou FIM</description></parameter>
      <parameter><name>STATUS</name><default_value>sucesso</default_value><description>Status ao finalizar</description></parameter>
      <parameter><name>LIDOS</name><default_value/><description>Quantidade lida</description></parameter>
      <parameter><name>GRAVADOS</name><default_value/><description>Quantidade gravada</description></parameter>
      <parameter><name>QUARENTENA</name><default_value/><description>Quantidade em quarentena</description></parameter>
      <parameter><name>MENSAGEM</name><default_value/><description>Mensagem operacional</description></parameter>
    </parameters>
  </info>
  <notepads/>
  <transform>
    <name>atualizar etapa</name>
    <type>TableInput</type>
    <description>Chama a funcao SQL correspondente a operacao solicitada</description>
    <connection>postgres_desafio</connection>
    <sql>SELECT CASE upper('${OPERACAO}')
         WHEN 'INICIO' THEN controle.iniciar_etapa('${EXECUCAO_ID}', '${ETAPA}')
         WHEN 'FIM' THEN controle.finalizar_etapa(
             '${EXECUCAO_ID}', '${ETAPA}', '${STATUS}',
             NULLIF('${LIDOS}', '')::integer,
             NULLIF('${GRAVADOS}', '')::integer,
             NULLIF('${QUARENTENA}', '')::integer,
             NULLIF('${MENSAGEM}', '')
         )
         ELSE controle.registrar_falha(
           '${EXECUCAO_ID}', '${ETAPA}',
           'Operacao de etapa invalida: ${OPERACAO}'
         )
       END AS controle_atualizado</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
    <GUI><xloc>128</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>

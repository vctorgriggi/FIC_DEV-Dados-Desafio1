<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><name>silver_interacao</name><name_sync_with_filename>Y</name_sync_with_filename><description>Valida e carrega interacoes na Silver</description><extended_description>Descarta no fluxo de aprovados as linhas sem referencias validas, preservando a Bronze para quarentena posterior.</extended_description><pipeline_version/><pipeline_type>Normal</pipeline_type><pipeline_status>0</pipeline_status><parameters><parameter><name>EXECUCAO_ID</name><default_value/><description>UUID da execucao Bronze corrente</description></parameter></parameters></info>
  <notepads/><order><hop><from>interacoes validas</from><to>normalizar textos</to><enabled>Y</enabled></hop><hop><from>normalizar textos</from><to>gravar silver</to><enabled>Y</enabled></hop></order>
  <transform><name>interacoes validas</name><type>TableInput</type><description>Validacao de dominio, faixa, data e referencias</description><connection>postgres_desafio</connection><sql>SELECT i.usuario_id::integer AS usuario_id, i.conteudo_id::integer AS conteudo_id, lower(unaccent(btrim(i.tipo_interacao))) AS tipo_interacao, i.data_hora::timestamp AS data_hora, NULLIF(btrim(i.tempo_consumido), '')::integer AS tempo_consumido, NULLIF(btrim(i.percentual_conclusao), '')::numeric(5,2) AS percentual_conclusao, NULLIF(btrim(i.avaliacao_atribuida), '')::smallint AS avaliacao_atribuida, i._execucao_id, i._origem, i._ingerido_em
FROM bronze.interacoes i JOIN silver.usuario u ON u.usuario_id = NULLIF(btrim(i.usuario_id), '')::integer AND u._execucao_id = i._execucao_id JOIN silver.conteudo c ON c.conteudo_id = NULLIF(btrim(i.conteudo_id), '')::integer AND c._execucao_id = i._execucao_id
WHERE i._execucao_id = '${EXECUCAO_ID}' AND btrim(i.usuario_id) ~ '^[0-9]+$' AND btrim(i.conteudo_id) ~ '^[0-9]+$' AND lower(unaccent(btrim(i.tipo_interacao))) IN ('visualizacao','inicio','conclusao','curtida','avaliacao','compartilhamento') AND btrim(i.data_hora) ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$' AND i.data_hora::timestamp &gt;= c.data_publicacao AND (NULLIF(btrim(i.tempo_consumido), '') IS NULL OR btrim(i.tempo_consumido) ~ '^[0-9]+$') AND (NULLIF(btrim(i.percentual_conclusao), '') IS NULL OR btrim(i.percentual_conclusao)::numeric BETWEEN 0 AND 100) AND (NULLIF(btrim(i.avaliacao_atribuida), '') IS NULL OR btrim(i.avaliacao_atribuida)::smallint BETWEEN 1 AND 5) AND (lower(unaccent(btrim(i.tipo_interacao)) ) &lt;&gt; 'conclusao' OR NULLIF(btrim(i.percentual_conclusao), '')::numeric = 100) AND (lower(unaccent(btrim(i.tipo_interacao)) ) &lt;&gt; 'avaliacao' OR NULLIF(btrim(i.avaliacao_atribuida), '') IS NOT NULL)</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><distribute>Y</distribute><copies>1</copies><GUI><xloc>128</xloc><yloc>96</yloc></GUI><partitioning><method>none</method><schema_name/></partitioning><attributes/></transform>
  <transform><name>normalizar textos</name><type>StringOperations</type><description>Limpeza textual com transformer nativo do Hop</description><fields><field><in_stream_name>tipo_interacao</in_stream_name><out_stream_name>tipo_interacao</out_stream_name><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><right_pad_char/><left_pad_char/><mask/></field></fields><distribute>Y</distribute><copies>1</copies><GUI><xloc>288</xloc><yloc>96</yloc></GUI><partitioning><method>none</method><schema_name/></partitioning><attributes/></transform>
  <transform><name>gravar silver</name><type>TableOutput</type><description>silver.interacao</description><connection>postgres_desafio</connection><schema>silver</schema><table>interacao</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><fields><field><column_name>usuario_id</column_name><stream_name>usuario_id</stream_name></field><field><column_name>conteudo_id</column_name><stream_name>conteudo_id</stream_name></field><field><column_name>tipo_interacao</column_name><stream_name>tipo_interacao</stream_name></field><field><column_name>data_hora</column_name><stream_name>data_hora</stream_name></field><field><column_name>tempo_consumido</column_name><stream_name>tempo_consumido</stream_name></field><field><column_name>percentual_conclusao</column_name><stream_name>percentual_conclusao</stream_name></field><field><column_name>avaliacao_atribuida</column_name><stream_name>avaliacao_atribuida</stream_name></field><field><column_name>_execucao_id</column_name><stream_name>_execucao_id</stream_name></field><field><column_name>_origem</column_name><stream_name>_origem</stream_name></field><field><column_name>_ingerido_em</column_name><stream_name>_ingerido_em</stream_name></field></fields><distribute>Y</distribute><copies>1</copies><GUI><xloc>416</xloc><yloc>96</yloc></GUI><partitioning><method>none</method><schema_name/></partitioning><attributes/></transform>
  <transform_error_handling/><attributes/>
</pipeline>



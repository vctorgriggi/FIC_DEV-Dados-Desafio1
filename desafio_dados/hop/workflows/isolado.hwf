<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>isolado</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Executa uma camada isoladamente (RF15): FLUXO=bronze abre uma execucao nova; FLUXO=silver, qualidade, gold ou metadados reprocessa a execucao informada</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <parameters><parameter><name>EXECUCAO_ID</name><default_value></default_value><description>UUID da execucao (vazio = gerar um novo)</description></parameter><parameter><name>FLUXO</name><default_value></default_value><description>bronze, silver, qualidade, gold ou metadados (nome de um workflow em hop/workflows/)</description></parameter><parameter><name>MODO</name><default_value>manual</default_value><description>manual ou agendado</description></parameter></parameters>
  <actions>
    <action>
      <name>inicio</name>
      <description></description>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>definir execucao</name>
      <description>usa o EXECUCAO_ID recebido ou gera um UUID</description>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/pipelines/definir_execucao.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>N</pass_all_parameters><parameter><name>EXECUCAO_ID</name><stream_name/><value>${EXECUCAO_ID}</value></parameter></parameters>
      <parallel>N</parallel>
      <xloc>192</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>abrir execucao</name>
      <description></description>
      <type>SQL</type>
      <attributes/>
      <sql>SELECT controle.abrir_execucao('${EXECUCAO_ID}', '${FLUXO}', '${MODO}')</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>Y</sendOneStatement>
      <connection>postgres_desafio</connection>
      <parallel>N</parallel>
      <xloc>352</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>registrar no log</name>
      <description></description>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <loglevel>Basic</loglevel>
      <logmessage>[${EXECUCAO_ID}] execucao aberta: fluxo ${FLUXO}, modo ${MODO}</logmessage>
      <logsubject/>
      <parallel>N</parallel>
      <xloc>512</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>finalizar execucao</name>
      <description></description>
      <type>SQL</type>
      <attributes/>
      <sql>SELECT controle.finalizar_execucao('${EXECUCAO_ID}')</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>Y</sendOneStatement>
      <connection>postgres_desafio</connection>
      <parallel>N</parallel>
      <xloc>864</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>fim</name>
      <description></description>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1024</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>finalizar execucao com falha</name>
      <description></description>
      <type>SQL</type>
      <attributes/>
      <sql>SELECT controle.finalizar_execucao('${EXECUCAO_ID}')</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>Y</sendOneStatement>
      <connection>postgres_desafio</connection>
      <parallel>N</parallel>
      <xloc>864</xloc>
      <yloc>336</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>abortar</name>
      <description></description>
      <type>ABORT</type>
      <attributes/>
      <message>[${EXECUCAO_ID}] execucao terminou com falha; ver controle.etapa</message>
      <always_log_rows>N</always_log_rows>
      <parallel>N</parallel>
      <xloc>1024</xloc>
      <yloc>336</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>executar camada</name>
      <description></description>
      <type>WORKFLOW</type>
      <attributes/>
      <filename>${PROJECT_HOME}/workflows/${FLUXO}.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>N</pass_all_parameters><parameter><name>EXECUCAO_ID</name><stream_name/><value>${EXECUCAO_ID}</value></parameter></parameters>
      <parallel>N</parallel>
      <xloc>704</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>definir execucao</from>
      <to>abrir execucao</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>abrir execucao</from>
      <to>registrar no log</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>finalizar execucao</from>
      <to>fim</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>finalizar execucao</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>finalizar execucao com falha</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>inicio</from>
      <to>definir execucao</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>registrar no log</from>
      <to>executar camada</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>executar camada</from>
      <to>finalizar execucao</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>executar camada</from>
      <to>finalizar execucao com falha</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>definir execucao</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>abrir execucao</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>

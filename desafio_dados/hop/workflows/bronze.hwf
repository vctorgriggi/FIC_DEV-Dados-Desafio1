<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>bronze</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Camada Bronze (RF20): ingere as cinco fontes com auditoria, uma etapa por fonte</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <parameters><parameter><name>EXECUCAO_ID</name><default_value></default_value><description>UUID da execucao (vazio = gerar um novo)</description></parameter></parameters>
  <actions>
    <action>
      <name>inicio</name>
      <description></description>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>abortar</name>
      <description></description>
      <type>ABORT</type>
      <attributes/>
      <message>[${EXECUCAO_ID}] bronze interrompida</message>
      <always_log_rows>N</always_log_rows>
      <parallel>N</parallel>
      <xloc>480</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>fontes presentes?</name>
      <description>pre-condicao da ingestao: todas as fontes precisam existir</description>
      <type>FILES_EXIST</type>
      <attributes/>
      <fields><field><name>${DIR_BRUTOS}/catalogo.csv</name></field><field><name>${DIR_BRUTOS}/usuarios.csv</name></field><field><name>${DIR_BRUTOS}/interacoes.json</name></field><field><name>${DIR_BRUTOS}/comentarios.json</name></field><field><name>${DIR_BRUTOS}/lote_2/catalogo.csv</name></field><field><name>${DIR_BRUTOS}/lote_2/usuarios.csv</name></field><field><name>${DIR_BRUTOS}/lote_2/interacoes.json</name></field><field><name>${DIR_BRUTOS}/lote_2/comentarios.json</name></field><field><name>${DIR_BRUTOS}/recomendacoes_desafio1.json</name></field></fields>
      <parallel>N</parallel>
      <xloc>192</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>registrar fonte ausente</name>
      <description></description>
      <type>SQL</type>
      <attributes/>
      <sql>SELECT controle.registrar_falha('${EXECUCAO_ID}', 'bronze_fontes', 'fonte obrigatoria ausente; conferir em dados/brutos: catalogo.csv, usuarios.csv, interacoes.json, comentarios.json, recomendacoes_desafio1.json e os quatro arquivos de lote_2/')</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>Y</sendOneStatement>
      <connection>postgres_desafio</connection>
      <parallel>N</parallel>
      <xloc>192</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>bronze_catalogo</name>
      <description></description>
      <type>WORKFLOW</type>
      <attributes/>
      <filename>${PROJECT_HOME}/workflows/etapa.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>N</pass_all_parameters><parameter><name>EXECUCAO_ID</name><stream_name/><value>${EXECUCAO_ID}</value></parameter><parameter><name>ETAPA</name><stream_name/><value>bronze_catalogo</value></parameter><parameter><name>PIPELINE</name><stream_name/><value>bronze_catalogo.hpl</value></parameter></parameters>
      <parallel>N</parallel>
      <xloc>352</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>bronze_usuarios</name>
      <description></description>
      <type>WORKFLOW</type>
      <attributes/>
      <filename>${PROJECT_HOME}/workflows/etapa.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>N</pass_all_parameters><parameter><name>EXECUCAO_ID</name><stream_name/><value>${EXECUCAO_ID}</value></parameter><parameter><name>ETAPA</name><stream_name/><value>bronze_usuarios</value></parameter><parameter><name>PIPELINE</name><stream_name/><value>bronze_usuarios.hpl</value></parameter></parameters>
      <parallel>N</parallel>
      <xloc>496</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>bronze_interacoes</name>
      <description></description>
      <type>WORKFLOW</type>
      <attributes/>
      <filename>${PROJECT_HOME}/workflows/etapa.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>N</pass_all_parameters><parameter><name>EXECUCAO_ID</name><stream_name/><value>${EXECUCAO_ID}</value></parameter><parameter><name>ETAPA</name><stream_name/><value>bronze_interacoes</value></parameter><parameter><name>PIPELINE</name><stream_name/><value>bronze_interacoes.hpl</value></parameter></parameters>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>bronze_comentarios</name>
      <description></description>
      <type>WORKFLOW</type>
      <attributes/>
      <filename>${PROJECT_HOME}/workflows/etapa.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>N</pass_all_parameters><parameter><name>EXECUCAO_ID</name><stream_name/><value>${EXECUCAO_ID}</value></parameter><parameter><name>ETAPA</name><stream_name/><value>bronze_comentarios</value></parameter><parameter><name>PIPELINE</name><stream_name/><value>bronze_comentarios.hpl</value></parameter></parameters>
      <parallel>N</parallel>
      <xloc>784</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>bronze_recomendacoes</name>
      <description></description>
      <type>WORKFLOW</type>
      <attributes/>
      <filename>${PROJECT_HOME}/workflows/etapa.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters><pass_all_parameters>N</pass_all_parameters><parameter><name>EXECUCAO_ID</name><stream_name/><value>${EXECUCAO_ID}</value></parameter><parameter><name>ETAPA</name><stream_name/><value>bronze_recomendacoes</value></parameter><parameter><name>PIPELINE</name><stream_name/><value>bronze_recomendacoes.hpl</value></parameter></parameters>
      <parallel>N</parallel>
      <xloc>928</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>fim</name>
      <description></description>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1072</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>bronze_catalogo</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>bronze_usuarios</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>bronze_catalogo</from>
      <to>bronze_usuarios</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>bronze_interacoes</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>bronze_usuarios</from>
      <to>bronze_interacoes</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>bronze_comentarios</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>bronze_interacoes</from>
      <to>bronze_comentarios</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>bronze_recomendacoes</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>bronze_comentarios</from>
      <to>bronze_recomendacoes</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>inicio</from>
      <to>fontes presentes?</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>fontes presentes?</from>
      <to>bronze_catalogo</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>fontes presentes?</from>
      <to>registrar fonte ausente</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>registrar fonte ausente</from>
      <to>abortar</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>bronze_recomendacoes</from>
      <to>fim</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>

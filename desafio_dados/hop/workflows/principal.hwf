  <action><name>silver recomendacao</name><type>PIPELINE</type><description>Silver recomendacao</description><filename>${PROJECT_HOME}/pipelines/silver_recomendacao.hpl</filename><run_configuration>local</run_configuration><work_directory/><exec_per_row>N</exec_per_row><params><pass_all_parameters>Y</pass_all_parameters></params><parallel>N</parallel><wait_until_finished>Y</wait_until_finished><logging_remote_work>N</logging_remote_work><set_logfile>N</set_logfile><logfile/><logext>log</logext><add_date>N</add_date><add_time>N</add_time><create_parent_folder>N</create_parent_folder><remote_filename/><attributes/><GUI><xloc>2176</xloc><yloc>192</yloc></GUI></action>
  <action><name>preparar metadados</name><type>WRITE_TO_LOG</type><description>Placeholder para futura chamada REST ao OpenMetadata</description><loglevel>basic</loglevel><logmessage>Etapa de metadados preparada; publicacao REST ainda nao habilitada nesta entrega. execucao=${EXECUCAO_ID}</logmessage><attributes/><GUI><xloc>1600</xloc><yloc>192</yloc></GUI></action>
  <action><name>finalizar execucao</name><type>PIPELINE</type><description>Fecha controle.execucao conforme a quarentena</description><filename>${PROJECT_HOME}/pipelines/controle_finalizacao.hpl</filename><run_configuration>local</run_configuration><work_directory/><exec_per_row>N</exec_per_row><params><pass_all_parameters>Y</pass_all_parameters></params><parallel>N</parallel><wait_until_finished>Y</wait_until_finished><logging_remote_work>N</logging_remote_work><set_logfile>N</set_logfile><logfile/><logext>log</logext><add_date>N</add_date><add_time>N</add_time><create_parent_folder>N</create_parent_folder><remote_filename/><attributes/><GUI><xloc>2368</xloc><yloc>192</yloc></GUI></action>
  <action><name>fim</name><type>SUCCESS</type><description>Fluxo concluido</description><attributes/><GUI><xloc>1792</xloc><yloc>192</yloc></GUI></action>
  </actions>
  <hops>
    <hop><from>inicio</from><to>abrir execucao</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>abrir execucao</from><to>bronze catalogo</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>bronze catalogo</from><to>bronze usuarios</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>bronze usuarios</from><to>bronze interacoes</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>bronze interacoes</from><to>bronze comentarios</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>bronze comentarios</from><to>bronze recomendacoes</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>bronze recomendacoes</from><to>silver usuario</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>silver usuario</from><to>silver conteudo</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>silver conteudo</from><to>quarentena validacao</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>quarentena validacao</from><to>silver interacao</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>silver interacao</from><to>silver comentario</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>silver comentario</from><to>silver recomendacao</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>silver recomendacao</from><to>preparar metadados</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>preparar metadados</from><to>finalizar execucao</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>finalizar execucao</from><to>fim</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
  </hops>
  <attributes/>
</workflow>

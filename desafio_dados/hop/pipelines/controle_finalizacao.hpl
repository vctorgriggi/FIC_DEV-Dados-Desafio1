<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><name>controle_finalizacao</name><name_sync_with_filename>Y</name_sync_with_filename><description>Finaliza o status da execucao</description><extended_description>Atualiza controle.execucao depois das cargas e considera pendencias da quarentena.</extended_description><pipeline_version/><pipeline_type>Normal</pipeline_type><pipeline_status>0</pipeline_status><parameters><parameter><name>EXECUCAO_ID</name><default_value/><description>UUID da execucao</description></parameter></parameters></info>
  <notepads/>
  <transform><name>finalizar execucao</name><type>TableInput</type><description>Atualiza controle.execucao</description><connection>postgres_desafio</connection><sql>SELECT controle.finalizar_execucao('${EXECUCAO_ID}') AS status</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><distribute>Y</distribute><copies>1</copies><GUI><xloc>128</xloc><yloc>96</yloc></GUI><partitioning><method>none</method><schema_name/></partitioning><attributes/></transform>
  <transform_error_handling/><attributes/>
</pipeline>

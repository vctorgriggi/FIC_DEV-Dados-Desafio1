  <action><name>quarentena validacao</name><type>PIPELINE</type><description>Registra rejeicoes da validacao Silver</description><filename>${PROJECT_HOME}/pipelines/quarentena_validacao.hpl</filename><run_configuration>local</run_configuration><work_directory/><exec_per_row>N</exec_per_row><params><pass_all_parameters>Y</pass_all_parameters></params><parallel>N</parallel><wait_until_finished>Y</wait_until_finished><logging_remote_work>N</logging_remote_work><set_logfile>N</set_logfile><logfile/><logext>log</logext><add_date>N</add_date><add_time>N</add_time><create_parent_folder>N</create_parent_folder><remote_filename/><attributes/><GUI><xloc>1792</xloc><yloc>192</yloc></GUI></action>
  <action><name>silver interacao</name><type>PIPELINE</type><description>Silver interacao validada</description><filename>${PROJECT_HOME}/pipelines/silver_interacao.hpl</filename><run_configuration>local</run_configuration><work_directory/><exec_per_row>N</exec_per_row><params><pass_all_parameters>Y</pass_all_parameters></params><parallel>N</parallel><wait_until_finished>Y</wait_until_finished><logging_remote_work>N</logging_remote_work><set_logfile>N</set_logfile><logfile/><logext>log</logext><add_date>N</add_date><add_time>N</add_time><create_parent_folder>N</create_parent_folder><remote_filename/><attributes/><GUI><xloc>1792</xloc><yloc>192</yloc></GUI></action>

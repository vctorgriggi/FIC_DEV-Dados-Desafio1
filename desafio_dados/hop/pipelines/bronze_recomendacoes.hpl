<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><name>bronze_recomendacoes</name><name_sync_with_filename>Y</name_sync_with_filename><description>Ingere o snapshot fixo de recomendacoes do Desafio 1</description><extended_description>Fonte unica: recomendacoes_desafio1.json. Nao usar public.recomendacao nem o arquivo processado.</extended_description><pipeline_version/><pipeline_type>Normal</pipeline_type><pipeline_status>0</pipeline_status><parameters><parameter><name>EXECUCAO_ID</name><default_value/><description>UUID da execucao</description></parameter></parameters><capture_transform_performance>N</capture_transform_performance><transform_performance_capturing_delay>1000</transform_performance_capturing_delay><transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit><created_user>-</created_user><modified_user>-</modified_user><key_for_session_key/><is_key_private>N</is_key_private></info>
  <notepads/>
  <order><hop><from>recomendacoes</from><to>auditoria</to><enabled>Y</enabled></hop><hop><from>auditoria</from><to>execucao</to><enabled>Y</enabled></hop><hop><from>execucao</from><to>gravar bronze</to><enabled>Y</enabled></hop></order>
    <transform>
      <type>JsonInput</type><name>recomendacoes</name><include>N</include><rownum>Y</rownum><rownum_field>_linha</rownum_field><limit>0</limit><valueField/><IsInFields>N</IsInFields><IsAFile>Y</IsAFile><readurl>N</readurl><removeSourceField>N</removeSourceField><shortFileFieldName>N</shortFileFieldName>
      <files><file><name>${DIR_BRUTOS}/recomendacoes_desafio1.json</name><filemask/><exclude_filemask/><file_required>Y</file_required><include_subfolders>N</include_subfolders></file></files>
      <fields>
        <field><name>usuario_id</name><type>String</type><path>usuario_id</path><length>-1</length><precision>-1</precision></field><field><name>conteudo_id</name><type>String</type><path>conteudo_id</path><length>-1</length><precision>-1</precision></field><field><name>ivis</name><type>String</type><path>ivis</path><length>-1</length><precision>-1</precision></field><field><name>icur</name><type>String</type><path>icur</path><length>-1</length><precision>-1</precision></field><field><name>iconc</name><type>String</type><path>iconc</path><length>-1</length><precision>-1</precision></field><field><name>pontuacao</name><type>String</type><path>pontuacao</path><length>-1</length><precision>-1</precision></field><field><name>classificacao</name><type>String</type><path>classificacao</path><length>-1</length><precision>-1</precision></field><field><name>afinidade</name><type>String</type><path>afinidade</path><length>-1</length><precision>-1</precision></field><field><name>posicao</name><type>String</type><path>posicao</path><length>-1</length><precision>-1</precision></field><field><name>gerado_em</name><type>String</type><path>gerado_em</path><length>-1</length><precision>-1</precision></field>
      </fields><distribute>Y</distribute><copies>1</copies><GUI><xloc>64</xloc><yloc>128</yloc></GUI><partitioning><method>none</method><schema_name/></partitioning><attributes/>
    </transform>
  <transform><name>auditoria</name><type>Constant</type><description>Auditoria do snapshot</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>_origem</name><type>String</type><format/><nullif>dados/brutos/recomendacoes_desafio1.json</nullif><set_empty_string>N</set_empty_string></field></fields><attributes/><GUI><xloc>288</xloc><yloc>128</yloc></GUI></transform>
  <transform><name>execucao</name><type>GetVariable</type><description>Materializa o identificador da execucao</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>_execucao_id</name><variable>${EXECUCAO_ID}</variable><type>String</type></field></fields><attributes/><GUI><xloc>416</xloc><yloc>128</yloc></GUI></transform>
  <transform><name>gravar bronze</name><type>TableOutput</type><description>Bronze append-only</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>postgres_desafio</connection><schema>bronze</schema><table>recomendacoes</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><fields><field><column_name>usuario_id</column_name><stream_name>usuario_id</stream_name></field><field><column_name>conteudo_id</column_name><stream_name>conteudo_id</stream_name></field><field><column_name>ivis</column_name><stream_name>ivis</stream_name></field><field><column_name>icur</column_name><stream_name>icur</stream_name></field><field><column_name>iconc</column_name><stream_name>iconc</stream_name></field><field><column_name>pontuacao</column_name><stream_name>pontuacao</stream_name></field><field><column_name>classificacao</column_name><stream_name>classificacao</stream_name></field><field><column_name>afinidade</column_name><stream_name>afinidade</stream_name></field><field><column_name>posicao</column_name><stream_name>posicao</stream_name></field><field><column_name>gerado_em</column_name><stream_name>gerado_em</stream_name></field><field><column_name>_execucao_id</column_name><stream_name>_execucao_id</stream_name></field><field><column_name>_origem</column_name><stream_name>_origem</stream_name></field><field><column_name>_linha</column_name><stream_name>_linha</stream_name></field></fields><attributes/><GUI><xloc>544</xloc><yloc>128</yloc></GUI></transform>
  <transform_error_handling/><attributes/>
</pipeline>

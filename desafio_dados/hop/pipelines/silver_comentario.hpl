<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><name>silver_comentario</name><name_sync_with_filename>Y</name_sync_with_filename><description>Valida, anonimiza e carrega comentarios na Silver</description><extended_description>Converte tags JSON para TEXT[] e aplica anonimizaÃ§Ã£o do texto livre.</extended_description><pipeline_version/><pipeline_type>Normal</pipeline_type><pipeline_status>0</pipeline_status><parameters><parameter><name>EXECUCAO_ID</name><default_value/><description>UUID da execucao Bronze corrente</description></parameter></parameters></info>
  <notepads/><order><hop><from>comentarios validos</from><to>normalizar textos</to><enabled>Y</enabled></hop><hop><from>normalizar textos</from><to>gravar silver</to><enabled>Y</enabled></hop></order>
  <transform><name>comentarios validos</name><type>TableInput</type><description>Validacao de referencias, avaliacao, data e tags</description><connection>postgres_desafio</connection><sql>SELECT c.usuario_id::integer AS usuario_id, c.conteudo_id::integer AS conteudo_id, c.avaliacao::smallint AS avaliacao, lgpd.anonimizar_texto(btrim(c.comentario)) AS comentario, ARRAY(SELECT jsonb_array_elements_text(c.tags::jsonb))::text[] AS tags, c.data::date AS data, c._execucao_id, c._origem, c._ingerido_em
FROM bronze.comentarios c JOIN silver.usuario u ON u.usuario_id = NULLIF(btrim(c.usuario_id), '')::integer AND u._execucao_id = c._execucao_id JOIN silver.conteudo k ON k.conteudo_id = NULLIF(btrim(c.conteudo_id), '')::integer AND k._execucao_id = c._execucao_id
WHERE c._execucao_id = '${EXECUCAO_ID}' AND btrim(c.usuario_id) ~ '^[0-9]+$' AND btrim(c.conteudo_id) ~ '^[0-9]+$' AND btrim(c.avaliacao) ~ '^[1-5]$' AND btrim(c.data) ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' AND c.data::date &gt;= k.data_publicacao AND NULLIF(btrim(c.comentario), '') IS NOT NULL AND jsonb_typeof(c.tags::jsonb) = 'array'</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><distribute>Y</distribute><copies>1</copies><GUI><xloc>128</xloc><yloc>96</yloc></GUI><partitioning><method>none</method><schema_name/></partitioning><attributes/></transform>
  <transform><name>normalizar textos</name><type>StringOperations</type><description>Limpeza textual com transformer nativo do Hop</description><fields><field><in_stream_name>comentario</in_stream_name><out_stream_name>comentario</out_stream_name><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><right_pad_char/><left_pad_char/><mask/></field></fields><distribute>Y</distribute><copies>1</copies><GUI><xloc>288</xloc><yloc>96</yloc></GUI><partitioning><method>none</method><schema_name/></partitioning><attributes/></transform>
  <transform><name>gravar silver</name><type>TableOutput</type><description>silver.comentario</description><connection>postgres_desafio</connection><schema>silver</schema><table>comentario</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><fields><field><column_name>usuario_id</column_name><stream_name>usuario_id</stream_name></field><field><column_name>conteudo_id</column_name><stream_name>conteudo_id</stream_name></field><field><column_name>avaliacao</column_name><stream_name>avaliacao</stream_name></field><field><column_name>comentario</column_name><stream_name>comentario</stream_name></field><field><column_name>tags</column_name><stream_name>tags</stream_name></field><field><column_name>data</column_name><stream_name>data</stream_name></field><field><column_name>_execucao_id</column_name><stream_name>_execucao_id</stream_name></field><field><column_name>_origem</column_name><stream_name>_origem</stream_name></field><field><column_name>_ingerido_em</column_name><stream_name>_ingerido_em</stream_name></field></fields><distribute>Y</distribute><copies>1</copies><GUI><xloc>416</xloc><yloc>96</yloc></GUI><partitioning><method>none</method><schema_name/></partitioning><attributes/></transform>
  <transform_error_handling/><attributes/>
</pipeline>


